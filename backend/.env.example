POSTGRES_USER=noc_admin
POSTGRES_PASSWORD=replace-with-your-local-database-password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_DB=noc_platform_db

# OneDrive energy sync is opt-in and requires production company sign-in.
ENERGY_ONEDRIVE_ENABLED=false
ENERGY_GRAPH_TENANT_ID=
ENERGY_GRAPH_CLIENT_ID=
ENERGY_GRAPH_DRIVE_ID=
ENERGY_GRAPH_ITEM_ID=
ENERGY_SYNC_INTERVAL_SECONDS=60
# Set the Graph credential only in the worker's protected environment or secret file.

# Hourly workbook delivery from a OneDrive desktop machine (no Graph credential).
ENERGY_FILE_PUSH_ENABLED=false
ENERGY_FILE_PUSH_SOURCE_ID=site-energy
ENERGY_FILE_PUSH_INTERVAL_SECONDS=3600
